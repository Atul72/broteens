NODE_ENV=development
PORT=4000
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://broteens:broteens@localhost:5433/broteens
REDIS_URL=redis://localhost:6379
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=broteens-api
AUTH_JWT_AUDIENCE=broteens-client
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_BCRYPT_COST=12
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
