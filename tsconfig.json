{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@broteens/contracts": ["packages/contracts/src/index.ts"],
      "@broteens/extractor": ["packages/extractor/src/index.ts"],
      "@broteens/queue": ["packages/queue/src/index.ts"],
      "@broteens/database": ["packages/database/src/index.ts"],
      "@broteens/core": ["packages/crawler/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
