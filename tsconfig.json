{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@broteens/contracts": ["./packages/contracts/src/index.ts"],
      "@broteens/extractor": ["./packages/extractor/src/index.ts"],
      "@broteens/queue": ["./packages/queue/src/index.ts"],
      "@broteens/database": ["./packages/database/src/index.ts"],
      "@broteens/core": ["./packages/crawler/src/index.ts"],
      "@broteens/auth": ["./packages/auth/src/index.ts"],
      "@broteens/errors": ["./packages/errors/src/index.ts"],
      "@broteens/features": ["./packages/features/src/index.ts"],
      "@broteens/hooks": ["./packages/hooks/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
