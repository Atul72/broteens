{
  "name": "broteens",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm check-types",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @broteens/auth-api dev",
    "dev:auth-api": "pnpm --filter @broteens/auth-api dev",
    "dev:reach-desk-backend": "pnpm --filter @broteens/reach-desk-backend dev",
    "db:push": "pnpm --filter @broteens/database db:push",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "turbo": "^2.7.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
